# DB_SSL_CA_FILE=C:/certs/supabase-ca.crt
DB_SCHEMA=feed
DB_SYNCHRONIZE=true

POSTGRES_USER=ajudaai
POSTGRES_PASSWORD=ajudaai
POSTGRES_DATABASE=ajudaai
POSTGRES_PORT=5433
