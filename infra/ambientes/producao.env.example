# Variáveis da API em PRODUÇÃO (Azure Container App "ajudaai-api").
# Modelo SEM valores. [secret] = secret do Container App.

# APP_ENV é o que distingue os ambientes; NODE_ENV=production nos dois.
APP_ENV=producao
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

CORS_ORIGINS=https://ajudaiweb.z<N>.web.core.windows.net   # o endereço exato sai do provisionamento

# [secret] ≥ 32 caracteres aleatórios, exclusivo de produção.
JWT_SECRET=

# --- Banco: projeto Supabase de PRODUÇÃO (separado da homologação) ---
DB_HOST=aws-0-<regiao>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=              # [secret]
DB_DATABASE=postgres
DB_SCHEMA=feed
DB_SSL=true
DB_SSL_CA=certs/supabase-ca.crt
DB_SYNCHRONIZE=false      # a API recusa subir com true em produção
SEED_DEMO_DATA=false      # a API recusa subir com true em banco remoto

# --- Login Microsoft ---
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
AUTH_ALLOWED_DOMAIN=pucminas.edu.br
# Coordenação: SÓ esta lista (a coordenadora fictícia não existe em produção).
COORDENADORES_EMAILS=

# --- Contas demo: DESLIGADAS (o código já ignora em produção; mantenha false) ---
AUTH_DEMO_ENABLED=false
# Não defina DEMO_CHAVE_ACESSO nem DEMO_OPERADORES em produção.

# Painel de QA: desligado em produção.
GAMIFICACAO_QA_EMAILS=
GAMIFICACAO_QA_PRODUCAO=false

AZURE_STORAGE_CONNECTION_STRING=   # [secret] conta/containers de PRODUÇÃO
RABBITMQ_URL=                       # [secret] instância de PRODUÇÃO
RABBITMQ_FEED_EXCHANGE=ajuda-ai.feed
RABBITMQ_FEED_QUEUE=ajuda-ai.feed.sse
