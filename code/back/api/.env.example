MICROSOFT_TENANT_ID=seu-tenant-id-do-entra-id
MICROSOFT_CLIENT_ID=seu-client-id-do-aplicativo
JWT_SECRET=gere-uma-senha-longa-e-aleatoria
AUTH_ALLOWED_DOMAIN=pucminas.edu.br
AUTH_DEMO_ENABLED=true
PORT=3000

# Banco lido pela API (este arquivo, em code/back/api/.env).
# Nuvem (Supabase): host do projeto, porta 5432 (ou 6543 no pooler), DB_SSL=true.
# Local (docker compose em code/): DB_HOST=localhost, DB_PORT=5433,
#   DB_USERNAME=ajudaai, DB_PASSWORD=ajudaai, DB_DATABASE=ajudaai, DB_SSL=false.
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=postgres
DB_SSL=true
# CA do provedor para validar o TLS (Supabase: Database Settings → SSL
# Configuration → Download certificate). Caminho relativo a code/back/api.
DB_SSL_CA=
DB_SCHEMA=feed
# true altera o schema automaticamente ao iniciar. Use false em banco
# compartilhado/nuvem. Antes de produção: migrations + synchronize desligado.
DB_SYNCHRONIZE=false
# Dados de demonstração (alunos, ciclos, participações, avisos). Só em banco
# local; com banco remoto a API se recusa a iniciar se estiver true.
SEED_DEMO_DATA=false
