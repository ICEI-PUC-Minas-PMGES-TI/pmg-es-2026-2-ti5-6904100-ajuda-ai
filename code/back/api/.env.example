# =========================
# AUTENTICAÇÃO
# =========================

# App público no Entra ID (sem client secret). O mesmo client ID vale para o
# Flutter. O audience do ID token precisa ser este valor.
# Redirect do app: br.pucminas.ajudaai://auth
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# Gere um segredo forte no seu .env real.
# Nunca coloque o JWT_SECRET real neste arquivo.
JWT_SECRET=gere-uma-senha-longa-e-aleatoria

AUTH_ALLOWED_DOMAIN=pucminas.edu.br

# Ambiente lógico: desenvolvimento (padrão), homologacao ou producao.
# Modelos completos dos ambientes publicados: infra/ambientes/*.env.example.
APP_ENV=desenvolvimento

# Login demo (sem senha). POST /auth/login-demo só aceita os e-mails da base
# demo. Produção: sempre desligado, qualquer que seja este valor.
# Desenvolvimento: fica ABERTO só se a API estiver isolada — banco local OU
# HOST=127.0.0.1 (o emulador Android continua chegando por 10.0.2.2). Com banco
# compartilhado e HOST=0.0.0.0 (rede/celular físico) ele EXIGE a chave abaixo.
# Alunos demo no banco: npm run seed:demo (uma vez).
AUTH_DEMO_ENABLED=true
# Chave de demonstração (≥ 24 caracteres), enviada no cabeçalho X-Demo-Chave.
# Obrigatória em homologação e em qualquer API exposta na rede. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEMO_CHAVE_ACESSO=
# E-mails (sessão Microsoft) que podem entrar em qualquer conta demo sem a chave.
DEMO_OPERADORES=

# Coordenação real: email|Nome, separados por vírgula. Em produção é a ÚNICA
# fonte de coordenadores (a coordenadora fictícia da base demo é desligada).
COORDENADORES_EMAILS=

# Origens aceitas pelo CORS (https, separadas por vírgula). Vazio = qualquer
# origem, só em desenvolvimento; obrigatória em homologação e produção.
CORS_ORIGINS=


# =========================
# API
# =========================

PORT=3000


# =========================
# BANCO DE DADOS
# =========================

# Este arquivo serve apenas como modelo.
# A API lê as configurações reais de:
# code/back/api/.env

# ---------------------------------------------------------
# SUPABASE / BANCO REMOTO
# ---------------------------------------------------------
#
# Exemplo:
# DB_HOST=db.SEUPROJETO.supabase.co
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=sua-senha
# DB_DATABASE=postgres
# DB_SCHEMA=feed
# DB_SSL=true
# DB_SSL_CA=certs/supabase-ca.crt
# DB_SYNCHRONIZE=false
# SEED_DEMO_DATA=false
#
# Em banco remoto:
# - NÃO use DB_SYNCHRONIZE=true
# - NÃO use SEED_DEMO_DATA=true
# - alterações estruturais devem ser feitas por migrations

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=postgres
DB_SCHEMA=feed

# =========================
# SUPABASE / BACKUP
# =========================

# URL do Session Pooler do Supabase.
#
# Usada apenas por ferramentas administrativas, como pg_dump/backup.
# Não substitui DB_HOST/DB_PORT usados normalmente pela API.
#
# Deve utilizar o Session Pooler na porta 5432.
#
# Nunca coloque a URL real neste arquivo de exemplo.
#
# Exemplo:
# SUPABASE_POOLER_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
SUPABASE_POOLER_URL=

# =========================
# SSL
# =========================

# Supabase utiliza SSL.
DB_SSL=true

# Caminho relativo a code/back/api.
# Baixe a CA oficial do provedor e coloque em certs/.
DB_SSL_CA=certs/supabase-ca.crt


# =========================
# TYPEORM / MIGRATIONS
# =========================

# Em banco compartilhado/remoto deve permanecer false.
# Alterações de schema devem ser feitas por migrations.
DB_SYNCHRONIZE=false


# =========================
# DADOS DE DEMONSTRAÇÃO
# =========================

# Cria alunos, ciclos, participações e avisos fictícios.
#
# Banco local:
# pode ser true para desenvolvimento.
#
# Banco remoto:
# deve ser false.
# A API se recusa a iniciar em banco remoto se estiver true.
SEED_DEMO_DATA=false


# =========================
# AZURE BLOB STORAGE
# =========================

# Connection String da conta do Azure Storage.
#
# Obtenha em:
# Azure Portal
# > Conta de armazenamento
# > Segurança + rede
# > Chaves de acesso
# > Cadeia de conexão
#
# NUNCA coloque a Connection String real neste arquivo.
# O valor real deve existir somente no .env local/seguro.
#
# Obrigatória em produção.
# Em desenvolvimento a API sobe sem ela (ou com o placeholder abaixo)
# e registra um aviso. Qualquer operação de arquivo falha até o valor
# real existir.

AZURE_STORAGE_CONNECTION_STRING=cole-a-connection-string-aqui

# Validade da SAS de leitura dos containers privados (profiles, feed, chat).
# Padrão: 15. Máximo aceito: 60.
# AZURE_STORAGE_SAS_LEITURA_MINUTOS=15

# Validade da SAS de upload (escrita de um único blob).
# Padrão: 10. Máximo aceito: 15.
# AZURE_STORAGE_SAS_UPLOAD_MINUTOS=10

# =========================
# MAPA / MAPBOX (configuração de build do Flutter)
# =========================

# O Flutter não lê este .env; passar por --dart-define ou arquivo local fora do Git.
# Token público pk. de runtime. Nunca colocar token secreto sk. no aplicativo.
MAPBOX_ACCESS_TOKEN=

# Base HTTPS pública do container map-assets, sem SAS/query ou credenciais.
# A versão e os caminhos dos GLBs vêm do manifesto empacotado.
# Exemplo: https://<storage-account>.blob.core.windows.net/map-assets
MAP_ASSETS_BASE_URL=

# Vazio usa o estilo padrão do pacote.
MAPBOX_STYLE_URI=

# Painel de medição; manter false em builds distribuídos.
CAMPUS_MAP_DIAGNOSTICS=false

# Feed: credencial de desenvolvimento do Compose. Sem URL, eventos aguardam na
# outbox e REST continua funcionando; configure o broker para entrega ao vivo.
RABBITMQ_URL=amqp://ajudaai:ajudaai-local@localhost:5672
RABBITMQ_FEED_EXCHANGE=ajuda-ai.feed
# Prefixo das filas exclusivas por instância (broadcast para servidores SSE).
RABBITMQ_FEED_QUEUE=ajuda-ai.feed.sse
RABBITMQ_CHAT_EXCHANGE=ajuda-ai.chat
RABBITMQ_CHAT_QUEUE=ajuda-ai.chat.sse

# 127.0.0.1 (recomendado): só este computador e o emulador Android (10.0.2.2).
# 0.0.0.0: qualquer aparelho da rede (celular físico) — com banco compartilhado,
# o login demo passa a exigir DEMO_CHAVE_ACESSO.
HOST=127.0.0.1

# Setup: docs/tecnico/mapa/setup-mobile.md
