COMPOSE_PROJECT_NAME=ajuda-ai
COMPOSE_FILE=docker-compose.yml

# Postgres local do docker compose (porta 5433 no host).
# Atenção: a conexão da API (DB_HOST, DB_PASSWORD...) NÃO é lida daqui;
# ela fica em code/back/api/.env (veja code/back/api/.env.example).
POSTGRES_USER=ajudaai
POSTGRES_PASSWORD=ajudaai
POSTGRES_DATABASE=ajudaai
POSTGRES_PORT=5433

# Credenciais apenas de desenvolvimento local.
RABBITMQ_USER=ajudaai
RABBITMQ_PASSWORD=ajudaai-local
