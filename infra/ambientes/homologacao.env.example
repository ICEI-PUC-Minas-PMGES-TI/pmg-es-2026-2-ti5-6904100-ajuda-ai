# Variáveis da API em HOMOLOGAÇÃO (Azure Container App "ajudaai-api-hml", ambiente "cae-ajudaai-wp").
# Modelo SEM valores. Os valores reais vão como "secrets" do Container App
# (marcados com [secret]) ou variáveis comuns — nunca neste arquivo nem no Git.

# APP_ENV é o que distingue os ambientes. NODE_ENV é production nos dois
# (convencional; é o valor do Dockerfile): não invente outro valor.
APP_ENV=homologacao
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Origens da web de homologação (https, sem barra final). Obrigatória.
CORS_ORIGINS=https://ajudaiwebhomolog.z<N>.web.core.windows.net   # o endereço exato sai do provisionamento

# [secret] ≥ 32 caracteres aleatórios, DIFERENTE do de produção e do .env local.
JWT_SECRET=

# --- Banco: projeto Supabase de HOMOLOGAÇÃO (dados fictícios) ---
# Container Apps só sai por IPv4: use o Session Pooler (porta 5432), não o host
# direto db.<ref>.supabase.co (IPv6 no plano Free).
DB_HOST=aws-0-<regiao>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=              # [secret]
DB_DATABASE=postgres
DB_SCHEMA=feed
DB_SSL=true
DB_SSL_CA=certs/supabase-ca.crt
DB_SYNCHRONIZE=false
SEED_DEMO_DATA=false

# --- Login Microsoft (app público no Entra ID) ---
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
AUTH_ALLOWED_DOMAIN=pucminas.edu.br
# Coordenação real (opcional em homologação): email|Nome, separados por vírgula.
# Quem também for operador das demos precisa estar aqui para ter sessão de acesso.
COORDENADORES_EMAILS=

# --- Contas demo: SÓ com porta ---
AUTH_DEMO_ENABLED=true
# [secret] Chave de demonstração (≥ 24 caracteres). Digitada na tela de login
# por quem apresenta (cabeçalho X-Demo-Chave). Troque após cada apresentação.
DEMO_CHAVE_ACESSO=
# E-mails Microsoft que podem entrar em qualquer conta demo sem a chave.
DEMO_OPERADORES=

# Painel de QA da gamificação (lista de e-mails).
GAMIFICACAO_QA_EMAILS=

# --- Arquivos e mensageria ---
AZURE_STORAGE_CONNECTION_STRING=   # [secret]
RABBITMQ_URL=                       # [secret] amqps://usuario:senha@<host>/<vhost>
RABBITMQ_FEED_EXCHANGE=ajuda-ai.feed
RABBITMQ_FEED_QUEUE=ajuda-ai.feed.sse
