COMPOSE_PROJECT_NAME=ajuda-ai
COMPOSE_FILE=docker-compose.yml

DB_HOST=db.zjvamkonqpvdybthgmlq.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-supabase-database-password
DB_DATABASE=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
